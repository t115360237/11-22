#include <stdio.h>

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int lcm(int a, int b) {
    return (a * b) / gcd(a, b);
}

int main(void) {
    int num1, num2;
    printf("Enter two integers: ");
    scanf("%d %d", &num1, &num2);
    printf("Least Common Multiple is: %d\n", lcm(num1, num2));
    return 0;
}

#include <stdio.h>

char changeCase(char c) {
    if (c >= 'A' && c <= 'Z') {
        return c + 32;
    } else if (c >= 'a' && c <= 'z') {
        return c - 32;
    }
    return c;
}

int main(void) {
    char c;
    printf("Enter a character: ");
    scanf(" %c", &c);
    printf("Result: %c\n", changeCase(c));
    return 0;
}

#include <stdio.h>

void solveHanoi(int disks, int source, int dest, int temp) {
    if (disks == 1) {
        printf("Shift disk 1 from peg %d to peg %d\n", source, dest);
        return;
    }
    solveHanoi(disks - 1, source, temp, dest);
    printf("Shift disk %d from peg %d to peg %d\n", disks, source, dest);
    solveHanoi(disks - 1, temp, dest, source);
}

int main(void) {
    int disks;
    printf("Enter number of disks: ");
    scanf("%d", &disks);
    solveHanoi(disks, 1, 3, 2);
    return 0;
}

#include <stdio.h>

unsigned long long int fibonacci(unsigned int n) {
    if (n == 0) return 0;
    if (n == 1) return 1;
    
    unsigned long long int a = 0;
    unsigned long long int b = 1;
    unsigned long long int c = 0;
    
    for (unsigned int i = 2; i <= n; i++) {
        c = a + b;
        a = b;
        b = c;
    }
    return c;
}

int main(void) {
    unsigned int n;
    printf("Enter n for Fibonacci: ");
    scanf("%u", &n);
    printf("Fibonacci(%u) = %llu\n", n, fibonacci(n));
    
    // (b) �M��t�Τ� unsigned long long int ��L�X���̤j Fibonacci ��
    unsigned long long int f1 = 0, f2 = 1, next = 0;
    unsigned int i = 0;
    while (1) {
        if (i == 0) { next = 0; }
        else if (i == 1) { next = 1; }
        else {
            if (f2 > 18446744073709551615ULL - f1) {
                printf("Largest Fibonacci index before overflow: %u\n", i - 1);
                printf("Largest Fibonacci value: %llu\n", f2);
